# =============================================================================
# InteriMatch AI - Configuration
# =============================================================================
# Copiez ce fichier en .env et renseignez vos valeurs

# -----------------------------------------------------------------------------
# IA / LLM (OpenAI-compatible via LangChain)
# -----------------------------------------------------------------------------
# Nom du modèle (ex: alfred-4.2, mistralai/mistral-small)
AI_MODEL=alfred-4.2

# URL du serveur LLM (API base URL, compatible OpenAI)
AI_SERVER_URL=https://trust.liveintelligence.orange-business.com

# Clé API pour le serveur LLM (si nécessaire)
AI_API_KEY=

# Température de génération (0.0 = déterministe, 1.0 = créatif)
AI_TEMPERATURE=0.3

# Nombre max de tokens en sortie
AI_MAX_TOKENS=2000

# -----------------------------------------------------------------------------
# Base de données PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://interimatch:interimatch@localhost:5432/interimatch
POSTGRES_USER=interimatch
POSTGRES_PASSWORD=interimatch
POSTGRES_DB=interimatch

# -----------------------------------------------------------------------------
# Redis (cache & tâches asynchrones)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# API France Travail
# -----------------------------------------------------------------------------
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_BASE_URL=https://api.francetravail.io/partenaire/offresdemploi/v2
FRANCE_TRAVAIL_AUTH_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token

# -----------------------------------------------------------------------------
# Sécurité / JWT
# -----------------------------------------------------------------------------
SECRET_KEY=CHANGEZ-MOI-EN-PRODUCTION-utilisez-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=InteriMatch AI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Taille max upload CV (en bytes) - défaut 10 Mo
MAX_UPLOAD_SIZE=10485760

# Répertoire de stockage des CV uploadés
UPLOAD_DIR=./uploads

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
