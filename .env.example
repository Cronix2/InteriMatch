# =============================================================================
# InteriMatch AI - Configuration
# =============================================================================
# Copiez ce fichier en .env et renseignez vos valeurs.
#
# ⚠️  PRODUCTION : ne JAMAIS committer le fichier .env. Tous les secrets
# (SECRET_KEY, DB password, API keys) doivent être uniques par environnement
# et générés aléatoirement (cf. commandes ci-dessous).

# -----------------------------------------------------------------------------
# IA / LLM (OpenAI-compatible via LangChain)
# -----------------------------------------------------------------------------
# Provider: groq | openrouter | mistral | together | ollama | openai | custom
# Sert de preset côté UI ; la clé/URL reste prioritaire si renseignée.
AI_PROVIDER=custom

# Nom du modèle (ex: alfred-4.2, mistralai/mistral-small, llama-3.3-70b-versatile)
AI_MODEL=alfred-4.2

# URL du serveur LLM (API base URL, compatible OpenAI)
# Presets: https://api.groq.com/openai/v1
#          https://openrouter.ai/api/v1
#          https://api.mistral.ai/v1
#          https://api.together.xyz/v1
#          http://ollama:11434/v1   (Ollama local)
AI_SERVER_URL=https://trust.liveintelligence.orange-business.com/api/v2

# Clé API pour le serveur LLM (laisser vide pour Ollama)
AI_API_KEY=

# Température de génération (0.0 = déterministe, 1.0 = créatif)
AI_TEMPERATURE=0.3

# Nombre max de tokens en sortie
AI_MAX_TOKENS=2000

# -----------------------------------------------------------------------------
# Ollama (LLM local, OPTIONNEL)
# -----------------------------------------------------------------------------
# Activation : `docker compose --profile ollama up -d`
# Sans ce profil, le service Ollama ne démarre pas (zéro espace disque utilisé).
#
# Modèle par défaut : qwen2.5:7b (~4.7 Go) — bon équilibre intelligence/taille,
# excellent en français et en sortie JSON structurée.
# Alternatives : qwen2.5:3b (~2 Go, plus léger), llama3.1:8b, mistral:7b
OLLAMA_MODEL=qwen2.5:7b

# -----------------------------------------------------------------------------
# Base de données PostgreSQL
# -----------------------------------------------------------------------------
# ⚠️  Changez le mot de passe en prod (openssl rand -base64 32)
DATABASE_URL=postgresql+asyncpg://interimatch:CHANGE_ME_DB_PASSWORD@localhost:5432/interimatch
POSTGRES_USER=interimatch
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=interimatch

# -----------------------------------------------------------------------------
# Redis (cache & tâches asynchrones)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# API France Travail
# -----------------------------------------------------------------------------
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_BASE_URL=https://api.francetravail.io/partenaire/offresdemploi/v2
FRANCE_TRAVAIL_AUTH_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=%2Fpartenaire

# -----------------------------------------------------------------------------
# Hunter.io (recherche email recruteur — fallback global, prioritaire = clé user)
# -----------------------------------------------------------------------------
# Clé Hunter.io par défaut si l'utilisateur n'en a pas configuré une dans Settings.
# Plan gratuit: 25 recherches/mois. Inscription : https://hunter.io
HUNTER_API_KEY=

# -----------------------------------------------------------------------------
# SMTP — envoi automatique des emails (fallback global, prioritaire = config user)
# -----------------------------------------------------------------------------
# Laisser vide pour forcer chaque utilisateur à configurer son propre SMTP.
# Exemple Gmail (avec mot de passe d'application) :
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=mon.adresse@gmail.com
#   SMTP_PASSWORD=app-password-16-chars
#   SMTP_USE_TLS=true
#   SMTP_FROM=mon.adresse@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=

# -----------------------------------------------------------------------------
# Sécurité / JWT
# -----------------------------------------------------------------------------
# ⚠️  OBLIGATOIRE : générez une clé forte avec :
#     openssl rand -hex 32
# Doit faire >= 32 caractères. L'app refuse de démarrer en production
# si la clé est vide ou trop courte.
SECRET_KEY=CHANGEZ-MOI-EN-PRODUCTION-utilisez-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# CORS (origines autorisées, séparées par des virgules)
# -----------------------------------------------------------------------------
# ⚠️  En prod, mettez UNIQUEMENT vos domaines réels (https://app.example.com).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Rate limiting (anti brute-force / DoS)
# -----------------------------------------------------------------------------
# Format slowapi : "5/minute", "100/hour", etc.
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=10/hour
RATE_LIMIT_DEFAULT=120/minute

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=InteriMatch AI
# development | staging | production
APP_ENV=development
# ⚠️  APP_DEBUG=true active l'écho SQL (fuite de schéma). Toujours false en prod.
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# Taille max upload CV (en bytes) - défaut 10 Mo
MAX_UPLOAD_SIZE=10485760

# Répertoire de stockage des CV uploadés (chemin absolu recommandé en prod)
UPLOAD_DIR=./uploads

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
